{
  "name": "devcontainers",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=12.0.0"
  },
  "dependencies": {
    "@devcontainers/cli": "^0.88.0"
  },
  "scripts": {
    "generate-docs:features": "npm exec @devcontainers/cli -- features generate-docs --registry=ghcr.io --namespace=froazin/devcontainer-features --github-owner=froazin --github-repo=devcontainers --project-folder=features/src",
    "generate-docs": "npm run generate-docs:features",
    "test:features:common-utils": "npm exec @devcontainers/cli -- features test --project-folder=features --skip-duplicated --skip-autogenerated --features=\"common-utils\"",
    "test:features": "npm exec @devcontainers/cli -- features test --project-folder=features --skip-duplicated --skip-autogenerated",
    "test": "npm run test:features"
  }
}
