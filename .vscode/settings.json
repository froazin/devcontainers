{
  "files.associations": {
    "**/images/src/*/template.json": "jinja-json"
  },
  "json.schemas": [
    {
      "fileMatch": ["/images/src/*/.devcontainer.json"],
      "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json"
    },
    {
      "fileMatch": ["/images/src/*/manifest.json"],
      "url": "./schemas/image-manifest.schema.json"
    }
  ]
}
